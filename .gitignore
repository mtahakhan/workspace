# Personal financial data and secrets - never commit these.
# This project is designed to be cloned with none of this present;
# skills/portfolio/references/BOOTSTRAP.md rebuilds it all from a
# user-provided transactions.csv on first run.
mcp_servers/portfolio_tools/.env
mcp_servers/portfolio_tools/data/manual/transactions.csv
mcp_servers/portfolio_tools/data/manual/transactions.csv.bak
mcp_servers/portfolio_tools/data/transaction_lots.csv
mcp_servers/portfolio_tools/data/price_history/*.jsonl
mcp_servers/portfolio_tools/data/daily-analysis/*.md
mcp_servers/portfolio_tools/data/analysis_history.jsonl
mcp_servers/portfolio_tools/data/news/**/*.txt

# NOTE: data/ticker_map.csv (ISIN, Ticker, Company, Sector) is deliberately NOT
# listed here - it's a shared, committed, ever-growing lookup table, not
# personal data. Don't add it back to this file.

# OS cruft
.DS_Store
**/.DS_Store

# portfolio MCP server's venv (needs Python >=3.10) - reproducible via
# `pip install -r mcp_servers/portfolio_tools/requirements.txt`, see bootstrap.sh
mcp_servers/portfolio_tools/.venv/
__pycache__/
**/__pycache__/

# Server runtime state - process metadata, not source or data
mcp_servers/portfolio_tools/data/.pipeline.lock
mcp_servers/portfolio_tools/.server.pid
mcp_servers/portfolio_tools/.server.log
